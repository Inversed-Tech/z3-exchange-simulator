# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Rust build output
target/

# Cloned Z3 stack — a throwaway working copy pinned by z3-commits.lock and
# populated by scripts/dev/clone-z3.sh. Never committed (not a submodule).
external/

# Experiment run outputs (generated data, not source)
experiments/runs/*/
!experiments/runs/.gitkeep

# Generated fixtures (output of `z3sim generate-fixtures`, regenerable)
experiments/fixtures/*
!experiments/fixtures/.gitkeep

# Generated findings reports (output of the reporting pipeline, regenerable)
experiments/reports/*
!experiments/reports/.gitkeep

# Local environment overrides — everything here is developer-specific
# (see configs/local/README.md), except the README itself.
configs/local/*
!configs/local/README.md
.env
.env.local

# Generated synthetic data
data/generated/
